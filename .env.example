# Reference only. PatchPilot does NOT auto-load .env files.
# Use Azure DevOps secret variables; never place live values in this file.
PP_AI_ENDPOINT=https://approved-ai-gateway.example/v1/chat/completions
PP_AI_MODEL=your-approved-model
PP_AI_TOKEN=
PP_ALLOW_SOURCE_UPLOAD=false

PP_SONAR_URL=https://sonarqube.example/
PP_SONAR_PROJECT=project-key
PP_SONAR_BRANCH=main
PP_SONAR_TOKEN=

# Exact immutable IQ RAW report URL. Cloud tenants may require /platform/.
PP_SONATYPE_REPORT_URL=https://iq.example/api/v2/applications/APP/reports/REPORT/raw
PP_SONATYPE_USER=
PP_SONATYPE_TOKEN=

# Omit PP_BITBUCKET_USER for supported bearer access tokens.
# Set it to the required account identity when using Basic API-token authentication.
PP_BITBUCKET_USER=
PP_BITBUCKET_TOKEN=

# Base64 of >=32 cryptographically random bytes, shared ONLY by verify/publish jobs.
PP_ATTESTATION_KEY=
PP_APPLY=false
PP_PUBLISH=false
PP_BUILD_URL=
